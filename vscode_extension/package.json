{
	"name": "snowstorm",
	"displayName": "Snowstorm",
	"description": "Minecraft Bedrock Edition particle editor",
	"version": "3.2.2",
	"publisher": "JannisX11",
	"engines": {
		"vscode": "^1.44.0"
	},
	"icon": "icon.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCustomEditor:x11.snowstorm",
		"onCommand:snowstorm.switchToSnowstorm"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/JannisX11/snowstorm"
	},
	"license": "GPL-3.0-or-later",
	"main": "./src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "snowstorm.switchToSnowstorm",
				"title": "Switch to Snowstorm"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "snowstorm.switchToSnowstorm",
					"when": "resourceFilename =~ /\\.particle\\.json$/ && activeCustomEditorId != x11.snowstorm",
					"group": "navigation"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "x11.snowstorm",
				"displayName": "Snowstorm Editor",
				"selector": [
					{
						"filenamePattern": "*.particle.json"
					}
				]
			}
		]
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"devDependencies": {
		"@vscode/vsce": "^2.26.1"
	},
	"scripts": {
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"keywords": [
		"snowstorm",
		"minecraft",
		"bedrock",
		"blockbench"
	]
}
